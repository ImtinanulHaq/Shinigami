# =============================================================
# .gitignore — Secure Linux Middleware
# Only source files and configs are tracked.
# All generated / runtime artifacts are excluded below.
# =============================================================

# ── Compiler output ──────────────────────────────────────────
*.o          # object files
*.a          # static archives
*.so         # shared libraries
*.so.*       # versioned shared libraries
*.lo         # libtool object
*.la         # libtool archive
*.d          # GCC dependency files
*.i          # pre-processed C source
*.s          # assembler output

# ── Executable binaries (Makefile targets) ───────────────────
servicemanager
bankai
service-broker

# ── Service daemon executables (built by CMake) ──────────────
# Use exact paths to avoid ignoring source directories with the same name
dev/services/build/audio_service/audio_service
dev/services/build/camera_service/camera_service
dev/services/build/sensor_service/sensor_service
dev/services/build/gpio_service/gpio_service

# ── Test executables (built by CMake) ────────────────────────
test_service_base
test_service_ipc
test_audio_hal_layer
test_camera_hal_layer
test_sensor_hal_layer
test_gpio_hal_layer
test_audio_full
test_camera_full
test_sensor_full
test_gpio_full

# ── CMake build trees ─────────────────────────────────────────
/build/
/bin/
services/build/
build/

# ── Runtime-generated files ───────────────────────────────────
*.pid        # PID files written to /run at daemon start
*.sock       # Unix domain socket files
*.log        # log files written by daemons

# ── IDE / editor noise ────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# CMake build directories
build/
bin/
lib/

# Middleware specific installation paths
install/

# Local artifacts from Bankai.sh
*.key
*.sock
*.dat
