# Build Configuration

## Cross-Compilation Settings

export ARCH=arm64
export CROSS_COMPILE=aarch64-linux-gnu-
export CC=$(CROSS_COMPILE)gcc
export AR=$(CROSS_COMPILE)ar

## Compiler Flags

# Architecture
export MARCH_FLAGS=-march=armv8-a

# Optimization (balance between size and speed)
export OPT_FLAGS=-O2

# Warning flags
export WARN_FLAGS=-Wall -Wextra -Werror=implicit-function-declaration

# Static linking (for embedded)
export STATIC_FLAGS=-static

## Combined CFLAGS
export CFLAGS=$(MARCH_FLAGS) $(OPT_FLAGS) $(WARN_FLAGS) $(STATIC_FLAGS)
export LDFLAGS=$(STATIC_FLAGS)

## Build Options

# Number of parallel jobs (use all cores)
export JOBS?=$(shell nproc)

# Verbose build output
export VERBOSE?=0

# Enable debug symbols
export DEBUG?=0

ifeq ($(DEBUG),1)
    CFLAGS += -g -DDEBUG
endif

ifeq ($(VERBOSE),1)
    MAKEFLAGS=
else
    MAKEFLAGS+=--no-print-directory
endif
