[Unit]
Description=Audio Hardware Abstraction Service
Documentation=man:audio_service(8)
After=network.target service_manager.service
Requires=service_manager.service

[Service]
Type=forking
PIDFile=/run/audio_service.pid
ExecStart=/usr/local/bin/audio_service -c /etc/audio_service/audio_service.conf
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -TERM $MAINPID

Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=20

User=audio
Group=audio
SupplementaryGroups=render

# Hardware access
DeviceAllow=char:/dev/snd rwm

# Resource limits (audio service is latency-sensitive, keep modest)
MemoryMax=64M
CPUQuota=15%
TasksMax=16

# Security hardening
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_RAWIO
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=no
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
ReadWritePaths=/var/log /run
ReadOnlyPaths=/etc/audio_service

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=audio_service

[Install]
WantedBy=multi-user.target
