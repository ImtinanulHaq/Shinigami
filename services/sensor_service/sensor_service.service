[Unit]
Description=Sensor Hardware Abstraction Service
Documentation=man:sensor_service(8)
After=network.target service_manager.service
Requires=service_manager.service

[Service]
Type=forking
PIDFile=/run/sensor_service.pid
ExecStart=/usr/local/bin/sensor_service -c /etc/sensor_service/sensor_service.conf
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -TERM $MAINPID

Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=20

User=sensor
Group=sensor

# Hardware access (IIO device nodes are owned by iio group)
SupplementaryGroups=iio

# Resource limits (sensor polling is light)
MemoryMax=32M
CPUQuota=10%
TasksMax=8

# Security hardening
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_RAWIO
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=no
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
ReadWritePaths=/var/log /run
ReadOnlyPaths=/etc/sensor_service

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sensor_service

[Install]
WantedBy=multi-user.target
