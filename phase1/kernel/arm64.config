#!/bin/bash
# Minimal kernel config for ARM64 QEMU
# Ye file Linux kernel ke liye configuration hai - ARM64 architecture ke liye
# =y matlab "enable this feature" (feature ko on kro)

# ============================================================================
# Basic kernel features - Memory management ka setup
# ============================================================================
# CONFIG_HAVE_MEMBLOCK=y
# Memory block support - kernel ke memory ko manage karne ka system
CONFIG_HAVE_MEMBLOCK=y

# CONFIG_ARCH_KEEP_MEMBLOCK=y
# Memory block ko memory mein rakhna - fast access ke liye (jaldi se access ho)
CONFIG_ARCH_KEEP_MEMBLOCK=y

# CONFIG_ARCH_FLATMEM_ENABLE=y
# Flat memory model use karo - simple memory layout (memory ko ek flat array jaise treat karo)
CONFIG_ARCH_FLATMEM_ENABLE=y

# CONFIG_FLATMEM=y
# Flat memory structure - no complex memory zones (physical memory ko simple way mein organize karo)
CONFIG_FLATMEM=y

# CONFIG_FLAT_NODE_MAP=y
# Flat node map - NUMA nodes ko simple tarike se map karo (multiple CPU cores ke memory ko manage karo)
CONFIG_FLAT_NODE_MAP=y

# CONFIG_PAGEFLAGS_EXTENDED=y
# Extended page flags - pages ke liye extra metadata (har page ke extra information store karo)
CONFIG_PAGEFLAGS_EXTENDED=y

# CONFIG_SPLIT_PTLOCK_CPUS=4
# Page table locks ko split karo jab 4 CPUs se zyada ho (lock contention kam karne ke liye)
CONFIG_SPLIT_PTLOCK_CPUS=4

# CONFIG_THREAD_INFO_IN_TASK=y
# Thread info ko task structure mein store karo (thread ki information ko efficiently store karo)
CONFIG_THREAD_INFO_IN_TASK=y

# ============================================================================
# ARM64 specific - 64-bit ARM processor ke liye specific features
# ============================================================================
# CONFIG_ARM64=y
# ARM64 architecture support enable karo (ye 64-bit ARM processors ke liye hai)
CONFIG_ARM64=y

# CONFIG_ARCH_DMA_ADDR_T_64BIT=y
# DMA (Direct Memory Access) addresses 64-bit honge (devices directly memory access kar saken efficiently)
CONFIG_ARCH_DMA_ADDR_T_64BIT=y

# CONFIG_ARCH_PHYS_ADDR_T_64BIT=y
# Physical memory addresses 64-bit honge (4GB se zyada memory access kar saken)
CONFIG_ARCH_PHYS_ADDR_T_64BIT=y

# CONFIG_64BIT=y
# 64-bit kernel banao (32-bit ke bajay - zyada powerful aur memory support)
CONFIG_64BIT=y

# ============================================================================
# QEMU virt machine support - Virtual machine ke liye specific settings
# ============================================================================
# CONFIG_QEMU_FIRMWARE=y
# QEMU firmware support - QEMU mein boot hone ke liye features enable karo
CONFIG_QEMU_FIRMWARE=y

# ============================================================================
# Console and logging - Output display aur messages dikhane ka setup
# ============================================================================
# CONFIG_PRINTK=y
# Kernel messages print karo console par (kernel kya kar raha hai ye dikhao)
CONFIG_PRINTK=y

# CONFIG_EARLY_PRINTK=y
# Early boot ke doran print karo - jab kernel start ho raha ho (very beginning mein messages dekho)
CONFIG_EARLY_PRINTK=y

# CONFIG_VT=y
# Virtual Terminal support - multiple terminals support (text-based terminals ko support karo)
CONFIG_VT=y

# CONFIG_VT_CONSOLE=y
# Virtual Terminal ko console banao - text output ke liye (VT ke zariye console output dekho)
CONFIG_VT_CONSOLE=y

# CONFIG_SERIAL_AMBA_PL011=y
# ARM PL011 UART serial driver - text communication ke liye hardware port (serial port se talk kro)
CONFIG_SERIAL_AMBA_PL011=y

# CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
# PL011 serial port ko console banao - QEMU mein output dekho (QEMU mein output dikhega yahan se)
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# ============================================================================
# Filesystem support - File system operations ka setup
# ============================================================================
# CONFIG_DEVTMPFS=y
# Device tmpfs - /dev directory ko automatically populate karo (devices automatically mein aa jayengi)
CONFIG_DEVTMPFS=y

# CONFIG_DEVTMPFS_MOUNT=y
# Device tmpfs ko automatically mount karo - boot time par mount ho jaye automatically
CONFIG_DEVTMPFS_MOUNT=y

# CONFIG_TMPFS=y
# Temporary filesystem support - /tmp aur /var/tmp ke liye RAM-based storage (temporary files RAM mein rakhne ke liye)
CONFIG_TMPFS=y

# CONFIG_PROC_FS=y
# /proc filesystem support - kernel ke running processes ki information dikhao (processes aur system info dekho)
CONFIG_PROC_FS=y

# CONFIG_SYSFS=y
# /sys filesystem support - kernel objects aur drivers ki information (/sys folder mein hardware info)
CONFIG_SYSFS=y

# ============================================================================
# Process management - Multiple processes aur multitasking ka support
# ============================================================================
# CONFIG_POSIX_TIMERS=y
# POSIX compliant timers - applications ko timing functionality dena (alarms, timers ka support)
CONFIG_POSIX_TIMERS=y

# CONFIG_PID_NS=y
# PID namespace - processes ko isolate karo (har process group ka apna PID numbering scheme)
CONFIG_PID_NS=y

# CONFIG_IPC_NS=y
# IPC namespace - Inter-Process Communication ko isolate karo (message queues, shared memory isolated)
CONFIG_IPC_NS=y

# CONFIG_UTS_NS=y
# UTS namespace - hostname/domainname ko isolate karo (har container ka apna hostname)
CONFIG_UTS_NS=y

# ============================================================================
# Core features - Main kernel functionality
# ============================================================================
# CONFIG_MODULES=y
# Loadable kernel modules support - kernel ke baad modules load kar sako (kernel features ko dynamically add karo)
CONFIG_MODULES=y

# CONFIG_MODULE_UNLOAD=y
# Modules ko unload karne ki feature - memory save karne ke liye modules ko remove kar sako
CONFIG_MODULE_UNLOAD=y

# CONFIG_BLK_DEV_INITRD=y
# Initial ramdisk support - boot time par filesystem load karo initrd se (QEMU mein rootfs.cpio.gz load hoga)
CONFIG_BLK_DEV_INITRD=y

# CONFIG_BLK_DEV_RAM=y
# RAM disk device support - /dev/ram0 /dev/ram1 etc devices (RAM ko disk jaise treat karo)
CONFIG_BLK_DEV_RAM=y

# CONFIG_BLK_DEV_RAM_SIZE=262144
# RAM disk ka size - 262144 KB = 256MB (kitni badi ramdisk banana hai)
CONFIG_BLK_DEV_RAM_SIZE=262144

# ============================================================================
# Networking (basic) - Network communication ka basic setup
# ============================================================================
# CONFIG_NET=y
# Networking support - network devices aur TCP/IP stack enable karo (network features ka support)
CONFIG_NET=y

# CONFIG_INET=y
# IPv4 protocol support - Internet communication ke liye (TCP/IP networking)
CONFIG_INET=y

# CONFIG_PACKET=y
# Packet socket - raw network packets ka support - debugging ke liye (packet-level mein send/receive karo)
CONFIG_PACKET=y

# CONFIG_UNIX=y
# Unix domain sockets - local IPC ke liye (processes same machine par communicate kar saken)
CONFIG_UNIX=y

# ============================================================================
# Misc - Random aur other important features
# ============================================================================
# CONFIG_HW_RANDOM=y
# Hardware random number generator support - security aur randomness ke liye (random numbers CPU se lo)
CONFIG_HW_RANDOM=y

# CONFIG_RANDOM_TRUST_BOOTLOADER=y
# Bootloader se entropy lo - random number generation ko better banao (bootloader se seed lo)
CONFIG_RANDOM_TRUST_BOOTLOADER=y

# CONFIG_HOTPLUG=y
# Hotplug support - devices ko runtime par add/remove kar sako (USB etc devices on the fly)
CONFIG_HOTPLUG=y
# CONFIG_PARTITION_ADVANCED=y
# Advanced partition table support - complex disk layouts ko support karo (GPT partitions etc)
CONFIG_PARTITION_ADVANCED=y


