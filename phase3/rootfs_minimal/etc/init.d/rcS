#!/bin/sh
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm

export HOME=/root
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

echo ""
echo "======================================"
echo "Phase 3 Mobile GUI System"
echo "======================================"
echo ""
echo "✅ System booted successfully"
echo "🖥️  Display: Ready for Wayland/Weston"
echo "📱 Touch: virtio-tablet enabled"
echo ""
echo "Commands:"
echo "  • ls /    - List root filesystem"
echo "  • free    - Memory usage"
echo "  • ps      - Running processes"
echo "  • exit    - Shutdown"
echo ""
/bin/sh
