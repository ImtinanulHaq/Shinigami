.PHONY : mw_mon_collectors/fast

#=============================================================================
# Target rules for targets named monitord

# Build rule for target.
monitord: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 monitord
.PHONY : monitord

# fast build rule for target.
monitord/fast:
	$(MAKE) $(MAKESILENT) -f dev/monitoring/CMakeFiles/monitord.dir/build.make dev/monitoring/CMakeFiles/monitord.dir/build
.PHONY : monitord/fast

